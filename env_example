TELEGRAM_BOT_TOKEN="token....code"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="token....code"
RECAPTCHA_SECRET_KEY="token....code"

# Site search. It is on only when BOTH are "true"; unset or any other value keeps it off everywhere
# (header button, burger row, /api/search, /search and /ro/search).
# NEXT_PUBLIC_SEARCH_ENABLED is baked into the bundle at build time, so after changing it redeploy.
# SEARCH_ENABLED is read by /api/search at runtime and by the /search pages at build time.
NEXT_PUBLIC_SEARCH_ENABLED="false"
SEARCH_ENABLED="false"

# Animated banner on the home pages (/ and /ro), above the "About" block.
# It is on only when the value is "true"; unset or any other value keeps the pages as they were.
# Read at build time, so after changing it redeploy.
HERO_BANNER_ENABLED="false"

# Banner on the lip enlargement pages (the service page and the blog pages about lips, RU and RO),
# below the header. It is on only when the value is "true"; unset or any other value keeps it off.
# It switches only the banner: the buttons of those pages open the lips quiz either way.
# Read at build time, so after changing it redeploy.
LIPS_BANNER_ENABLED="false"

# Closing banner with the survey invitation on the lip enlargement pages (the service page, the hub and
# the articles about lips, RU and RO): before the contacts block, before the footer on blog pages.
# It is on only when the value is "true"; unset or any other value keeps it off. On the service page it
# takes the place of the grey closing box, and in the articles and hubs about lips it replaces the
# "Записаться на увеличение губ" card (cards of other rubrics stay). While the variable is off, the
# grey box and the cards stay.
# Read at build time, so after changing it redeploy.
LIPS_END_BANNER_ENABLED="false"

# Google reviews (Featurable service, react-google-reviews carousel): the block on the home page (RU and RO), the
# pages /otzyvy and /ro/recenzii, their sitemap entries, the "Отзывы" link in the header, footer and burger. On only
# when the value is "true"; unset or any other value keeps all of it off and the site as before. Read at build time,
# so after changing it redeploy. The reviews are read on the server and cached for a day; no Google Maps key and no
# Google Cloud billing are needed. FEATURABLE_WIDGET_ID is the widget ID (the part after "featurable-" in its embed
# code); without it, or when the API does not answer, the block shows nothing (the reason goes to the build log).
# FEATURABLE_API_BASE is for tests only (address of a local stub of the API); do not set it in production.
GOOGLE_REVIEWS_ENABLED="false"
FEATURABLE_WIDGET_ID=""

# Indicators on the booking and call buttons (the dot on "Call", the call button's pulse and shake,
# the glow of the "Book online" button).
# "true": the dot is green during reception hours (Tue, Thu-Sat 13:00-18:00, Europe/Chisinau) and red
#   with a white bar at all other times and on days off; outside the hours the call button stops
#   pulsing and shaking and the "Book online" glow gets stronger.
# "false" or unset: the dot is always green and the call animation always runs.
# Baked into the bundle at build time, so after changing it redeploy. Set "true" in Vercel for the
# live site (Production and Preview), otherwise the indicators always show "open".
NEXT_PUBLIC_INDICATORS_CTA_LOGIC_ENABLED="false"
