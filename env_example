TELEGRAM_BOT_TOKEN="token....code"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="token....code"
RECAPTCHA_SECRET_KEY="token....code"

# Site search. It is on only when BOTH are "true"; unset or any other value keeps it off everywhere
# (header button, burger row, /api/search, /search and /ro/search).
# NEXT_PUBLIC_SEARCH_ENABLED is baked into the bundle at build time, so after changing it redeploy.
# SEARCH_ENABLED is read by /api/search at runtime and by the /search pages at build time.
NEXT_PUBLIC_SEARCH_ENABLED="false"
SEARCH_ENABLED="false"

# Animated banner on the home pages (/ and /ro), above the "About" block.
# It is on only when the value is "true"; unset or any other value keeps the pages as they were.
# Read at build time, so after changing it redeploy.
HERO_BANNER_ENABLED="false"
