{
  "name": "meddera-new-design",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "browserslist": {
    "production": [
      "chrome >= 109",
      "edge >= 109",
      "firefox >= 109",
      "safari >= 16.4",
      "ios_saf >= 16.4",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "next analyze",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "generate:blog-part2": "node scripts/generate-blog-part2.mjs",
    "generate:blog-urls": "node scripts/export-blog-article-urls.mjs",
    "verify:blog-content": "node scripts/verify-blog-metadata-content.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:ga4": "node scripts/verify-ga4.mjs",
    "verify:cta": "node scripts/verify-cta.mjs",
    "verify:hero-banner": "node scripts/verify-hero-banner.mjs",
    "verify:lips-lead": "node --test scripts/verify-lips-lead.mjs",
    "verify:lips-banner": "node scripts/verify-lips-banner.mjs",
    "verify:lips-banner:off": "node scripts/verify-lips-banner.mjs --expect=off",
    "verify:lips-end": "node scripts/verify-lips-end-banner.mjs",
    "verify:lips-end:off": "node scripts/verify-lips-end-banner.mjs --expect=off",
    "verify:indicators": "node scripts/verify-indicators.mjs",
    "verify:search:off": "node scripts/verify-search.mjs --expect=off",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@next/third-parties": "^16.4.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.4.0",
    "react-phone-number-input": "^3.4.18",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "postcss": "^8.5.30"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
