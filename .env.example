# =============================================================================
# Скопируйте в .env.local и заполните. В Vercel: Settings → Environment Variables.
# Секреты не коммитьте.
#
# --- Vercel Production: без этих трёх формы вернут 503 на /api/form-token ---
# 1) Подключите Upstash Redis (Marketplace) → UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# 2) Добавьте FORM_TOKEN_SECRET (≥ 16 символов), например: openssl rand -base64 48
# 3) Пересоберите деплой после сохранения переменных
# Аварийно: DISABLE_FORM_ABUSE_PROTECTION=1 отключает защиту (только reCAPTCHA).
# =============================================================================

NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# reCAPTCHA v3 + Telegram (формы контактов)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Защита форм: rate limit + anti-replay + HMAC-токен
# Код: src/proxy.ts, src/lib/contact-form-processor.ts, src/lib/form-token.ts
# -----------------------------------------------------------------------------

# --- Upstash Redis (обязательно для продакшена с защитой форм) ---
# После установки интеграции в Vercel Marketplace переменные часто подставляются сами.
# Имена должны совпадать с этими (используются в коде как есть):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Секрет для подписи токена GET /api/form-token (HMAC). Минимум ~16 символов;
# в проде — длинная случайная строка (например: openssl rand -base64 48).
FORM_TOKEN_SECRET=

# Аварийный откат: только старая логика (reCAPTCHA → Telegram), без токена/скоринга/Redis replay.
# DISABLE_FORM_ABUSE_PROTECTION=1

# -----------------------------------------------------------------------------
# Опционально (локальная отладка / старые флаги)
# -----------------------------------------------------------------------------
# ENABLE_TRUSTED_TYPES=false
# DISABLE_CSP=1

# ANALYZE=true

# -----------------------------------------------------------------------------
# Поиск по сайту. Включён только когда ОБЕ переменные равны "true";
# если не заданы или иное значение, поиск выключен везде
# (кнопка в шапке, строка в бургер-меню, /api/search, /search и /ro/search).
# NEXT_PUBLIC_SEARCH_ENABLED вшивается в сборку: после смены нужен Redeploy.
# SEARCH_ENABLED читает /api/search во время работы, а страницы /search — при сборке.
# В Vercel задайте обе переменные (Production и Preview) до push.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SEARCH_ENABLED=false
SEARCH_ENABLED=false

# -----------------------------------------------------------------------------
# Анимированный баннер на главных страницах (/ и /ro), перед блоком «Обо мне».
# Включён только при значении "true"; если не задана или иное значение, баннера нет
# и страницы выглядят как раньше. Читается при сборке: после смены нужен Redeploy.
# В Vercel задайте переменную (Production и Preview).
# -----------------------------------------------------------------------------
HERO_BANNER_ENABLED=false

# -----------------------------------------------------------------------------
# Баннер на страницах про увеличение губ (страница услуги и статьи блога про губы, RU и RO),
# под шапкой. Включён только при значении "true"; если не задана или иное значение, баннера нет.
# Управляет только баннером: кнопки этих страниц («Записаться онлайн», карточки, тизер)
# в любом случае открывают квиз про губы. Читается при сборке: после смены нужен Redeploy.
# В Vercel задайте переменную (Production и Preview).
# -----------------------------------------------------------------------------
LIPS_BANNER_ENABLED=false

# -----------------------------------------------------------------------------
# Нижний баннер «Пройти опрос» на страницах про увеличение губ (страница услуги, хаб и статьи
# блога про губы, RU и RO): перед блоком контактов, на статьях перед футером. Включён только при
# значении "true"; если не задана или иное значение, баннера нет. На странице услуги при
# включении баннер заменяет серый блок «Готовы подчеркнуть свою красоту?», а в статьях и хабах
# про губы заменяет карточку «Записаться на увеличение губ» (карточки других рубрик остаются).
# При выключенной переменной серый блок и карточки на месте. Читается при сборке: после смены нужен Redeploy.
# В Vercel задайте переменную (Production и Preview).
# -----------------------------------------------------------------------------
LIPS_END_BANNER_ENABLED=false

# -----------------------------------------------------------------------------
# Отзывы Google (компонент Place Details Element из Places UI Kit): блок на главной (RU и RO),
# страницы /otzyvy и /ro/recenzii, их записи в sitemap, ссылка «Отзывы» в подвале. Включено только
# при значении "true"; если не задана или иное значение, ничего этого нет и сайт как прежде.
# Читается при сборке: после смены нужен Redeploy. В Vercel задайте переменные (Production и Preview).
# GOOGLE_REVIEWS_ENABLED  - переключатель.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY - ключ Google Maps Platform для браузера. В Google Cloud включите API
#   «Places UI Kit» (и Maps JavaScript API), ограничьте ключ по HTTP-реферерам
#   https://meddera.md/* и https://www.meddera.md/*, добавьте платёжный аккаунт и бюджетное оповещение.
# NEXT_PUBLIC_GOOGLE_PLACE_ID - Place ID карточки клиники (Place ID Finder). Без ключа или Place ID
#   блок не показывается.
# -----------------------------------------------------------------------------
GOOGLE_REVIEWS_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# -----------------------------------------------------------------------------
# Индикаторы на кнопках записи и звонка (точка на «Позвонить», пульсация и покачивание
# звонка, свечение «Записаться онлайн»).
# true: точка зелёная в часы приёма (вт, чт–сб 13:00–18:00, Europe/Chisinau) и красная
#       с белой чертой в остальное время и в выходные; вне часов приёма пульсация
#       и покачивание звонка отключаются, свечение «Записаться» усиливается.
# false или не задана: точка всегда зелёная, анимация звонка всегда включена.
# Вшивается в сборку: после смены нужен Redeploy. В Vercel для боевого сайта задайте true
# (Production и Preview), иначе индикаторы будут показывать «всегда открыто».
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INDICATORS_CTA_LOGIC_ENABLED=false
